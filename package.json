{
  "name": "dsh-recorder-card",
  "version": "0.5.0",
  "description": "Development-preview DSH plugin to import recordings from compatible BLE recorder cards, with optional transcription and fingerprint-linked archives. Requires recorder hardware, Host Bluetooth and Python dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SynSwarm/dsh-recorder-card.git"
  },
  "homepage": "https://github.com/SynSwarm/dsh-recorder-card#readme",
  "bugs": {
    "url": "https://github.com/SynSwarm/dsh-recorder-card/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "recorder",
    "recording-card",
    "voice-recorder",
    "ble",
    "bluetooth",
    "audio",
    "ai-recorder",
    "meeting-transcription"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "test": "node scripts/sync-client-contract.mjs --check && node --test tests/*.test.js",
    "sync:client": "node scripts/sync-client-contract.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:cli": "python -m unittest discover -s tests -p \"test_*.py\""
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./service": "./runtime/service.js",
    "./remote": "./runtime/remote.js",
    "./typert": "./typert.host.js",
    "./remote-client": "./typert.remote-client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "typert.host.js",
    "typert.remote-client.js",
    "cordis.patch.yml",
    "vendor/",
    "skill/",
    "runtime/recorder_cli.py",
    "runtime/host-cli.js",
    "runtime/connection.js",
    "runtime/recorder_worker.py",
    "runtime/tools.js",
    "runtime/service.js",
    "runtime/device-settings.js",
    "runtime/transcription.js",
    "runtime/remote.js",
    "runtime/remote-contract.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
