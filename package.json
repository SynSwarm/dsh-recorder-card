{
  "name": "dsh-recorder-card",
  "version": "0.2.0",
  "description": "Development-preview DSH plugin for AI recorder cards, with browser BLE control, a pinned CLI adapter, and recorder_* agent tools for scan, list, import, and transcription. DSH integration and hardware verification pending.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "recorder",
    "recording-card",
    "voice-recorder",
    "ble",
    "bluetooth",
    "audio",
    "ai-recorder"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check:package": "node scripts/check-package.mjs",
    "test:cli": "python -m unittest discover -s tests -p \"test_cli_adapter.py\""
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "vendor/",
    "skill/",
    "runtime/recorder_cli.py",
    "runtime/host-cli.js",
    "runtime/tools.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
